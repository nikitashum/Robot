<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>ButikkPilot.Web</RootNamespace>
    <!-- No ICU download (-1.5 MB, one fewer file that can 404); we format numbers ourselves. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!-- The API compresses on the fly; precompressed .br/.gz copies would only bloat the container image. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the wire contracts. The server logic and system prompt never ship to the browser. -->
    <ProjectReference Include="..\ButikkPilot.Contracts\ButikkPilot.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ButikkPilot.Tests" />
  </ItemGroup>

  <!-- appsettings.Development.json points at a local API for split dev; it must never be published. -->
  <Target Name="RemoveDevSettingsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_DevSettings Include="$(PublishDir)wwwroot\appsettings.Development.json*" />
    </ItemGroup>
    <Delete Files="@(_DevSettings)" />
  </Target>

</Project>
