{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Data": {
    "Directory": "data"
  },
  "Llm": {
    "Provider": "Stub",
    "Model": "gpt-4o-mini",
    "ApiVersion": "2024-10-21",
    "MaxCompletionTokens": 600,
    "AttemptTimeoutSeconds": 20,
    "DailyRequestLimit": 300
  },
  "Sessions": {
    "MaxSessions": 500,
    "IdleMinutes": 30,
    "MaxLifetimeHours": 4
  },
  "RateLimit": {
    "ChatPerMinute": 20,
    "MaxConcurrentChats": 16
  }
}
